# ASCII-only project configuration
# Force consistent behavior across platforms

# Text files - normalize line endings
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts were the one extension the ASCII gate globbed, the pre-commit
# hook cased on, and this file never pinned. With core.autocrlf=true a Windows
# checkout hands pre-commit-hook.sh and blog_manager.sh a "#!/bin/bash\r"
# shebang, and the kernel then reports the interpreter as missing under a name
# that looks correct in every editor.
*.sh text eol=lf

# Source code files - treat as text
*.py text
*.md text
*.json text

# Explicitly mark as binary (no text processing)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary

# Export ignore for cleaner archives
.gitattributes export-ignore
.gitignore export-ignore
pre-commit-hook.sh export-ignore
ASCII_CODING_STANDARDS.md export-ignore

# Data files are hash-verified against MANIFEST.sha256. With
# core.autocrlf=true these would check out as CRLF on Windows and every
# integrity check would fail, so pin them to LF explicitly.
*.jsonl text eol=lf
*.sha256 text eol=lf
