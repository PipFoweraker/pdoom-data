# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
# ...but scripts/build/ is source, not a Python build artifact
!scripts/build/

# Data pipeline
logs/
*.log
*.log.*
.migration_state.json
data/_backups/
data/raw/_archive/
*.bak

# Large raw data dumps (regenerable via scripts/extraction/)
# To regenerate: python scripts/extraction/extract_alignment_research.py --min-date 2016-01-01
data/raw/alignment_research/dumps/*/data.jsonl

# Temporary files
.tmp_*
tmp/
temp/

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Databases
*.db
*.sqlite
*.sqlite3

# Environment
.env
.venv
venv/

# Local dev metrics database. Untracked from 2026-07-30: it is a binary
# artefact that was tracked despite matching a gitignore pattern, so every
# local run produced a spurious diff.
dev_metrics.db

# Generated review surface. Rebuild with:
#   python scripts/review/build_scan_view.py --limit N
# Embeds the current unreviewed pile, so it is stale the moment a verdict
# lands. Regenerable in a second; 600KB of derived HTML is not history.
tools/scan_view.html
.venv-checks/
.venv-print/
