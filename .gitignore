# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
# ...but scripts/build/ is source, not a Python build artifact
!scripts/build/

# Data pipeline
logs/
*.log
*.log.*
.migration_state.json
data/_backups/
data/raw/_archive/
*.bak

# Large raw data dumps (regenerable via scripts/extraction/)
# To regenerate: python scripts/extraction/extract_alignment_research.py --min-date 2016-01-01
data/raw/alignment_research/dumps/*/data.jsonl

# Temporary files
.tmp_*
tmp/
temp/

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Databases
*.db
*.sqlite
*.sqlite3

# Environment
.env
.venv
venv/

# Local dev metrics database. Untracked from 2026-07-30: it is a binary
# artefact that was tracked despite matching a gitignore pattern, so every
# local run produced a spurious diff.
dev_metrics.db

# Generated review surface. Rebuild with:
#   python scripts/review/build_scan_view.py --limit N
# Embeds the current unreviewed pile, so it is stale the moment a verdict
# lands. Regenerable in a second; 600KB of derived HTML is not history.
tools/scan_view.html
.venv-checks/
.venv-print/
.venv-checks/
.venv-print/
data/curated/watchlist/triage_log.jsonl

# Render artifacts from coordination's walkpack printer. Printing any doc in
# this repo drops four of these in the root: walkpack.html, walkpack.pdf, and
# two numbered PDFs. They are build output of a tool that lives in another
# repo, so nothing here regenerates them and nothing here should carry them.
# Ignored rather than deleted by hand -- remembering to delete is a document,
# and this is the mechanism version.
walkpack.html
walkpack*.pdf

# Fetched arXiv abstracts for a corpus-review sitting. Same treatment as the
# alignment_research dumps above and for the same two reasons: it is a fetch
# that scripts/review/prepare_corpus_review.py reproduces from the seed in
# frame.json, and real abstracts carry non-ASCII author names and mathematics
# that the ASCII gate would reject. Folding them would be damage, not
# compliance. _metadata.json IS tracked -- that is the provenance.
data/raw/arxiv_abstracts/dumps/*/data.jsonl

# The generated corpus-review sheet. Rebuilt every time the server starts.
tools/corpus_review.html
